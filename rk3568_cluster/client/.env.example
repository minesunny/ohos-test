RK3568_SERVER_WS_URL=ws://127.0.0.1:3770
RK3568_CLIENT_ID=
RK3568_CLIENT_NAME=
RK3568_HDC_POLL_INTERVAL_MS=5000
RK3568_CLIENT_RECONNECT_MS=3000

# Path to xts_env directory (contains docker-compose.env.yml)
RK3568_XTS_ENV_DIR=../xts_env

# Client local runtime dir for task cache and mounts
RK3568_CLIENT_WORK_DIR=./runtime

# Optional fixed TDD host repo path override (default: <xts_env>/TDD)
RK3568_TDD_HOST_DIR=

# Optional auth headers for DCP artifact download
DCP_AUTHORIZATION=
DCP_COOKIE=
DCP_TOKEN=
