# GitCode repositories config (optional fallback when account settings are empty)
# multi-target, owner/repo separated by comma or newline
# Example: OpenHarmony/arkcompiler_ets_runtime,OpenHarmony/arkui_ace_engine
# GITCODE_TARGETS=your-owner/your-repo,another-owner/another-repo

# Backward compatible single-target config (used when GITCODE_TARGETS is not set)
GITCODE_OWNER=your-owner
GITCODE_REPO=your-repo

GITCODE_TOKEN=your-token

# Optional, defaults to https://api.gitcode.com/api/v5
# GITCODE_API_BASE=https://api.gitcode.com/api/v5

# RK3568 test runtime options
# RK3568_BASE_DIR=/home/maien/TDD
# RK3568_FLASH_SCRIPT=~/ark-standalone-build/flash.sh

# Realtime websocket options (for dashboard auto-update and RK3568 live logs)
# REALTIME_WS_PORT=3765
# REALTIME_WS_HOST=0.0.0.0
# REALTIME_WS_PUBLIC_HOST=127.0.0.1
# NEXT_PUBLIC_REALTIME_WS_URL=ws://127.0.0.1:3765

# RK3568 client-agent websocket options (server -> client control channel)
# RK3568_CLIENT_WS_PORT=3770
# RK3568_CLIENT_WS_HOST=0.0.0.0
# RK3568_CLIENT_WS_PUBLIC_HOST=127.0.0.1
# RK3568_CLIENT_WS_PUBLIC_URL=ws://127.0.0.1:3770

# Next.js dev allowed origins (comma/newline separated hosts)
# ALLOWED_DEV_ORIGINS=172.16.1.2,localhost

# Session cookie secure policy (optional)
# auto (unset): detect from request protocol/x-forwarded-proto
# AUTH_COOKIE_SECURE=true   always secure (HTTPS only)
# AUTH_COOKIE_SECURE=false  allow HTTP login in private/network test env

# Optional DCP auth headers when pipeline/artifact page requires auth
# DCP_AUTHORIZATION=Bearer xxx
# DCP_COOKIE=your_cookie
# DCP_TOKEN=your_x_auth_token
