DEVICE_IP=
DEVICE_PORT=8710
DEVICE_SN=
TASK_TYPE=UT
TEST_PART=
TEST_MODULE=
PRODUCT_FORM=rk3568
TEST_SUITE_NAME=
TEST_CASE=
TEST_COVERAGE=
TEST_RANDOM=
TEST_PARTDEPS=
TEST_REPEAT=
TEST_HISTORYLIST=
TEST_RUNHISTORY=
TEST_RETRY=0
PREPARED_REPOS_ONLY=1
TEST_CASES_DIR=/workspace/tests
TEST_IMAGE_DIR=/workspace/images
REPORTS_DIR=/workspace/TDD/testfwk_developer_test/reports
DOWNLOAD_ROOT=/workspace/downloads

# host mount paths
TDD_HOST_DIR=./TDD
TEST_CASES_HOST_DIR=./tests
IMAGE_HOST_DIR=./images
REPORTS_HOST_DIR=./reports
DOWNLOAD_HOST_DIR=./downloads
USB_BUS_HOST_DIR=/dev/bus/usb
USB_BUS_CONTAINER_DIR=/dev/bus/usb
UDEV_RUN_HOST_DIR=/run/udev
UDEV_RUN_CONTAINER_DIR=/run/udev

# container images
OHOS_TDD_ENV_IMAGE=ohos-tdd-env:latest
OHOS_TDD_AUTO_IMAGE=ohos-tdd-auto:latest

# optional: set a unique project name when multiple checkouts share the same xts_env directory name
COMPOSE_PROJECT_NAME=

# auto mode only
AUTO_PREPARED_REPOS_ONLY=1
RK3568_IMAGE_URL=
TDD_CASES_URL=
HDC_URL=
HDC_BINARY_PATH=

DEV_REPO_URL=https://gitcode.com/openharmony/testfwk_developer_test.git
XDEVICE_REPO_URL=https://gitcode.com/openharmony/testfwk_xdevice.git
DEV_REPO_BRANCH=
XDEVICE_REPO_BRANCH=
# fixed commits (recommended)
DEV_REPO_COMMIT=359ee0ff6224bd609858a2ab02b6c492e777ac0c
XDEVICE_REPO_COMMIT=05b7d77ec52f8b6b17e2741f989c32fcf12184e2

# host-side dependency preparation
CONFIG_FILE=./wheels/offline_deps.json

# optional proxy passthrough for container runtime
http_proxy=
https_proxy=
ftp_proxy=
no_proxy=localhost,127.0.0.1
